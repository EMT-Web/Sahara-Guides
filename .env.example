# Copy to .env.local for local development, and set the same values in Vercel.

# Site
NEXT_PUBLIC_SITE_URL=https://saharaguides.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@saharaguides.com

# Sanity CMS (site works without these, serving the Markdown guides)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Only for scripts/import-to-sanity.mjs (Editor token). Never expose publicly.
SANITY_API_TOKEN=

# Email (Resend): contact form + newsletter
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=Sahara Guides <web@saharaguides.com>
RESEND_AUDIENCE_ID=

# Search engine verification (meta tags)
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Analytics that set cookies (loaded only after consent). Leave empty to disable.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Social profiles (used in Organization schema)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_PINTEREST_URL=
NEXT_PUBLIC_YOUTUBE_URL=
